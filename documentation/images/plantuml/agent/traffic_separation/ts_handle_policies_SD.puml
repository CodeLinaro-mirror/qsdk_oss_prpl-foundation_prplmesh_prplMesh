@startuml
participant "ApAutoConfigurationTask" as ACT
participant "slave_thread" as ST
participant "TaskPool" as TP
participant "TrafficSeparationTask" as TST
participant "TrafficSeparationManager" as TSM
participant "TrunkPortPlumbing8021q" as TPQ
participant "AccessPortPlumbing8021q" as APQ
participant "network_utils" as NU
participant "broker_client" as BC
participant "BPL cfg" as BPL
participant "AgentDB" as DB

== Boot-time registration ==
ST -> DB : read multi_ap_profile\n+ is_multiap_profile_1_as_of_r4

alt profile supports TS or R4-as-R1 compatibility mode
  ST -> TP : add_task(TrafficSeparationTask)
else plain Profile-1 boot
  ST -> ST : do not add TrafficSeparationTask
end

== Trigger ==
ACT -> ST : task_pool_try_send_event(TRAFFIC_SEPARATION, TS_ENABLE)
ST -> TP : try_send_event(TRAFFIC_SEPARATION, TS_ENABLE)

alt TrafficSeparationTask registered
  TP -> TST : TS_ENABLE event
  TST -> TST : schedule_apply()\nwait debounce
else task absent for Profile-1 boot config
  TP -> TP : return false
end

== work(): Full apply ==
opt TrafficSeparationTask registered
TST -> BC : configure_primary_vlan_id(primary_vid, add=true)
TST -> TSM : reset()
TST -> BPL : cfg_get_private_bridge_iface()\ncfg_get_guest_bridge_iface()
TST -> DB : collect persistent trunks/access ports
note right of TST
Full rebuild remains policy-driven.
Runtime WDS churn no longer waits for debounce.
end note
TST -> TSM : configure(cfg)

loop for each discovered trunk port
  TST -> TSM : add_trunk_port(trunk_port)
  ' TS not yet applied, so no plumbing->apply() here
end

loop for each discovered access port (BSS)
  TST -> TSM : add_access_port(access_port)
  ' TS not yet applied, so no plumbing->apply() here
end

TST -> TSM : apply_policies()

loop for each [iface, plumbing] in m_trunk_port_plumbing_map
  TSM -> TPQ : apply(cfg)

  alt trunk is UNTAGGED (trunk.is_untagged_mode == true)
    TPQ -> TPQ : m_last_cfg = cfg\nm_is_applied = true\n(no L2 changes)
  else trunk is TAGGED
    TPQ -> NU : linux_remove_iface_from_bridge(cfg.private_bridge, trunk.iface_name)
    TPQ -> NU : create_vlan_interface(trunk.iface_name, cfg.private_vid)
    TPQ -> NU : create_vlan_interface(trunk.iface_name, cfg.guest_vid)
    TPQ -> NU : set_interface_state(m_private_subiface, up)
    TPQ -> NU : set_interface_state(m_guest_subiface, up)
    TPQ -> NU : linux_add_iface_to_bridge(cfg.private_bridge, m_private_subiface)
    TPQ -> NU : linux_add_iface_to_bridge(cfg.guest_bridge, m_guest_subiface)
    TPQ -> TPQ : m_last_cfg = cfg\nm_is_applied = true
  end
end

loop for each [iface, plumbing] in m_access_port_plumbing_map
  TSM -> APQ : apply(cfg)
  APQ -> APQ : check m_is_applied, iface_name
  APQ -> NU  : set_vlan_packet_filter(true, access_port.iface_name)
  APQ -> APQ : m_is_applied = true
end

TSM -> TSM : m_state = APPLIED
end

== Handle exact WDS iface notification ==
ST -> ST : process WDS iface notification
ST -> DB : resolve radio by bssid
alt client already associated
  ST -> ST : set_client_wds_iface()\nstore WDS iface
  opt previous WDS iface differs
    ST -> TP : try_send_event(TRAFFIC_SEPARATION, TS_CLEAR_WDS_IFACE, old_iface_name)
    TP -> TST : TS_CLEAR_WDS_IFACE(old_iface_name) event
    TST -> TSM : remove_trunk_port(old_iface_name)
  end
  ST -> TP : try_send_event(TRAFFIC_SEPARATION, TS_NEW_WDS_IFACE, iface_name)
  alt TrafficSeparationTask registered
    TP -> TST : TS_NEW_WDS_IFACE(iface_name) event
    TST -> DB : match iface to active backhaul BSS
    alt matching backhaul BSS found
      TST -> TST : resolve mode from\nbBSS disallow flags + policy
      TST -> TSM : add_trunk_port(exact WDS iface)
      TSM -> TPQ : apply(cfg)  ' immediate because manager is APPLIED
    else no matching backhaul BSS
      TST -> TST : ignore event
    end
  else task absent for Profile-1 boot config
    TP -> TP : return false
  end
else notification races ahead of association
  ST -> ST : cache {bssid, iface_name}\nin m_pending_wds_iface_notifications
  note right of ST
    Deferred path keeps the exact-WDS update local
    until process_client_association() creates the
    associated client entry.
  end note
end

== Association consumes cached WDS iface ==
ST -> DB : create associated client entry
opt cached WDS iface exists for client
  alt cached bssid matches association bssid
    ST -> ST : apply cached iface via set_client_wds_iface()
    ST -> TP : try_send_event(TRAFFIC_SEPARATION, TS_NEW_WDS_IFACE, iface_name)
    alt TrafficSeparationTask registered
      TP -> TST : TS_NEW_WDS_IFACE(iface_name) event
      TST -> DB : match iface to active backhaul BSS
      TST -> TSM : add_trunk_port(exact WDS iface)
      TSM -> TPQ : apply(cfg)
    else task absent for Profile-1 boot config
      TP -> TP : return false
    end
  else cached bssid is stale
    ST -> ST : drop cached WDS iface notification
  end
end

== Clear exact WDS state on disconnect ==
alt associated client has active WDS iface
  ST -> ST : resolve current WDS iface\nbefore erase_client()
  ST -> TP : try_send_event(TRAFFIC_SEPARATION, TS_CLEAR_WDS_IFACE, iface_name)
  alt TrafficSeparationTask registered
    TP -> TST : TS_CLEAR_WDS_IFACE(iface_name) event
    TST -> TSM : remove_trunk_port(iface_name)
    alt iface was managed
      TSM -> TPQ : clear()
    else iface not tracked
      TST -> TST : return success
    end
  else task absent for Profile-1 boot config
    TP -> TP : return false
  end
else no associated client WDS iface
  ST -> ST : no TS clear event is needed
end
opt matching cached WDS iface exists
  ST -> ST : erase cached WDS iface notification
end
ST -> DB : erase_client()

== Clear ==
opt TrafficSeparationTask registered and TS_CLEAR is emitted
  ST -> TP : try_send_event(TRAFFIC_SEPARATION, TS_CLEAR)
  TP -> TST : TS_CLEAR event
  TST -> TSM : reset()
  TST -> BC : configure_primary_vlan_id(0, add=false)
  TST -> BC : configure_interfaces(bridge, {}, true, true)
end

note over ACT,TST
WDS runtime lifecycle is event-driven only:
no WDS debounce mode.
TS_ENABLE remains the only scheduled apply trigger.
Exact-WDS add can be deferred inside slave_thread
until association makes the client state valid.
Full reset does not recreate WDS .sta trunks.
end note

@enduml
