@startuml
participant "ApAutoConfigurationTask" as ACT
participant "slave_thread" as ST
participant "TaskPool" as TP
participant "TrafficSeparationTask" as TST
participant "TrafficSeparationManager" as TSM
participant "TrunkPortPlumbing8021q" as TPQ
participant "AccessPortPlumbing8021q" as APQ
participant "network_utils" as NU
participant "broker_client" as BC
participant "BPL cfg" as BPL
participant "AgentDB" as DB

== Boot-time registration ==
ST -> DB : read agent profile and TS support
alt TS supported
  ST -> TP : add_task(TrafficSeparationTask)
else TS unsupported
  ST -> ST : task is not registered
end

== TS apply ==
ACT -> ST : task_pool_try_send_event(TRAFFIC_SEPARATION, TS_APPLY)
ST -> TP : try_send_event(TRAFFIC_SEPARATION, TS_APPLY)
alt task exists
  TP -> TST : TS_APPLY event
  TST -> TST : request_apply()
else task absent
  TP -> TP : return false
end

opt task exists
  TST -> DB : read primary_vlan_id
  alt primary_vlan_id == 0 or invalid
    TST -> TST : cleanup_ts_runtime_state()
    TST -> TSM : clear_policies()
    TST -> BC : configure_primary_vlan_id(0, add=false)
    TST -> BC : configure_interfaces(bridge, {}, true, true)
  else valid TS policy
    TST -> BC : configure_primary_vlan_id(primary_vid, add=true)
    TST -> TSM : clear_policies()
    TST -> BPL : cfg_get_private_bridge_iface()\ncfg_get_guest_bridge_iface()
    TST -> DB : collect persistent DB-owned trunks\n(selected backhaul connection + LAN)
    TST -> TSM : configure(cfg)
    loop for each persistent trunk
      TST -> TSM : add_trunk_port(trunk)
    end
    TST -> TSM : apply_policies()

    loop for each managed trunk
      TSM -> TPQ : apply(cfg)
      alt untagged trunk
        TPQ -> TPQ : keep parent iface native\nno L2 changes
      else tagged wireless trunk
        TPQ -> NU : remove parent iface from bridge
        TPQ -> NU : create private VLAN subiface
        TPQ -> NU : create guest VLAN subiface
        TPQ -> NU : add subifaces to private and guest bridges
      else tagged ethernet trunk
        TPQ -> NU : create guest VLAN subiface
        TPQ -> NU : add guest subiface to guest bridge
      end
    end

    loop for each managed access port
      TSM -> APQ : apply(cfg)
      alt access iface exists
        APQ -> NU : set_vlan_packet_filter(true, iface_name)
      else access iface vanished
        APQ -> NU : linux_iface_exists(iface_name) == false
        APQ -> APQ : warn and skip
      end
    end
  end
end

== Handle pure FH AP enable ==
ACT -> ST : task_pool_try_send_event(TRAFFIC_SEPARATION, TS_NEW_FH_IFACE, iface_name)
ST -> TP : try_send_event(TRAFFIC_SEPARATION, TS_NEW_FH_IFACE, iface_name)
alt task exists
  TP -> TST : TS_NEW_FH_IFACE(iface_name) event
  TST -> TSM : add_access_port(access_port)
  alt manager state is APPLIED
    TSM -> APQ : apply(cfg)
    alt iface exists
      APQ -> NU : linux_iface_exists(iface_name)
      APQ -> NU : set_vlan_packet_filter(true, iface_name)
    else iface missing
      APQ -> NU : linux_iface_exists(iface_name) == false
      APQ -> APQ : warn and skip
    end
  end
else task absent
  TP -> TP : return false
end

== Handle pure FH disable or disappearance ==
ST -> DB : mark BSS disabled on AP_DISABLED\nor VAPS_LIST_UPDATE transition
ST -> TP : try_send_event(TRAFFIC_SEPARATION, TS_CLEAR_FH_IFACE, iface_name)
alt task exists
  TP -> TST : TS_CLEAR_FH_IFACE(iface_name) event
  TST -> TSM : remove_access_port(iface_name)
  alt iface was managed and manager state is APPLIED
    TSM -> APQ : clear()
    alt iface still exists
      APQ -> NU : linux_iface_exists(iface_name)
      APQ -> NU : set_vlan_packet_filter(false, iface_name)
    else iface vanished before cleanup
      APQ -> NU : linux_iface_exists(iface_name) == false
      APQ -> APQ : treat as already cleared
    end
  else iface not tracked
    TST -> TST : return success
  end
else task absent
  TP -> TP : return false
end

== Handle exact WDS iface notification ==
ST -> ST : process WDS iface notification
ST -> DB : resolve radio by bssid
alt client already associated
  ST -> ST : set_client_wds_iface()\nstore WDS iface
  opt previous WDS iface differs
    ST -> TP : try_send_event(TRAFFIC_SEPARATION, TS_CLEAR_WDS_IFACE, old_iface_name)
    alt task exists
      TP -> TST : TS_CLEAR_WDS_IFACE(old_iface_name) event
      TST -> TSM : remove_trunk_port(old_iface_name)
    end
  end
  ST -> TP : try_send_event(TRAFFIC_SEPARATION, TS_NEW_WDS_IFACE, iface_name)
  alt task exists
    TP -> TST : TS_NEW_WDS_IFACE(iface_name) event
    TST -> DB : match iface to active backhaul BSS
    alt matching backhaul BSS found
      TST -> TST : resolve mode from\nbBSS disallow flags + policy
      TST -> TST : cache {not_before, deadline}\nin m_pending_wds_ifaces if new
      alt settle delay not elapsed yet
        TST -> TST : schedule_deferred_work(not_before)\nreturn success
      else iface missing or tagged iface not ready
        alt retry deadline not reached
          TST -> TST : schedule_deferred_work(retry_due)\nreturn success
        else retry deadline expired
          TST -> TST : warn and drop pending WDS iface
        end
      else iface ready
        TST -> TSM : remove_trunk_port(iface_name)\nrefresh same-name reconnect
        TST -> TSM : add_trunk_port(exact WDS iface)
        TSM -> TPQ : apply(cfg)
      end
    else no matching backhaul BSS
      TST -> TST : ignore event
    end
  else task absent
    TP -> TP : return false
  end
else notification races ahead of association
  ST -> ST : cache {bssid, iface_name}\nin m_pending_wds_iface_notifications
end

== Association consumes cached WDS iface ==
opt legacy STA was already associated on another bssid
  ST -> TP : try_send_event(TS_CLEAR_WDS_IFACE, old_iface_name)
  note right of ST
    Old exact WDS trunk is cleared before
    erase_client(client_mac) removes the previous
    association state.
  end note
end
ST -> DB : erase_client(client_mac)
ST -> DB : create associated client entry
opt cached WDS iface exists for client
  alt cached bssid matches association bssid
    ST -> ST : apply cached iface via set_client_wds_iface()
    ST -> TP : try_send_event(TRAFFIC_SEPARATION, TS_NEW_WDS_IFACE, iface_name)
    alt task exists
      TP -> TST : TS_NEW_WDS_IFACE(iface_name) event
      TST -> TST : follow the same deferred settle\nand bounded retry path
    else task absent
      TP -> TP : return false
    end
  else cached bssid is stale
    ST -> ST : drop cached WDS iface notification
  end
end

== Disallow-triggered exact WDS refresh ==
alt AP_ENABLED or VAPS_LIST_UPDATE changes backhaul disallow flags
  ACT -> ST : AP_ENABLED path detects disallow delta
  ST -> ST : or VAPS_LIST_UPDATE detects disallow delta\nfor the same active backhaul BSS
  loop for each associated client on that BSS with wds_iface_name
    ST -> TP : try_send_event(TS_CLEAR_WDS_IFACE, iface_name)
    ST -> TP : try_send_event(TS_NEW_WDS_IFACE, iface_name)
    TP -> TST : recompute trunk mode from current\ndisallow flags + policy
  end
end

== Stale clear and disconnect cleanup ==
alt empty WDS notification arrives after client moved
  ST -> ST : ignore stale cleared WDS iface notification
else associated client disconnects with active WDS iface
  ST -> TP : try_send_event(TRAFFIC_SEPARATION, TS_CLEAR_WDS_IFACE, iface_name)
  alt task exists
    TP -> TST : TS_CLEAR_WDS_IFACE(iface_name) event
    TST -> TSM : remove_trunk_port(iface_name)
    opt manager state is APPLIED
      TSM -> TPQ : clear()
    end
  end
  ST -> ST : erase cached WDS notification for client and bssid
  ST -> DB : erase_client(client_mac, bssid)
end

note over ACT,TST
FH and WDS runtime lifecycles are event-driven.
No debounce is used for incremental add and remove events.

work() runs reconcile() for a pending TS_APPLY.
WDS readiness retry also runs from work() after the
settle delay, so handle_event() does not sleep.

reconcile() only refreshes config and persistent
DB-owned trunks. Event-managed FH and WDS ports stay
owned by their runtime events.
end note

@enduml
