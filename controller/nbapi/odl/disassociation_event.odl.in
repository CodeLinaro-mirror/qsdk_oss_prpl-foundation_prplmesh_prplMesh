%config {
    define-behavior = {
        existing-object = "update"
    };
}

%define {
    select @DATAELEMENTS_ROOT_DM@ {
        /**
        * This object contains the events generated when an Associated Device (STA)
        * disassociates from a BSS.
        * @version 2.19.1
        */
        object DisassociationEvent {
            /**
            * The event is generated when an Associated Device (STA) disassociates from a BSS.
            */
            event 'Disassociated!' {
                string BSSID;
                string MACAddress;
                uint32 ReasonCode;
                uint64 BytesSent;
                uint64 BytesReceived;
                uint64 PacketsSent;
                uint64 PacketsReceived;
                uint32 ErrorsSent;
                uint32 ErrorsReceived;
                uint32 RetransCount;
                datetime TimeStamp;
                uint32 LastDataDownlinkRate;
                uint32 LastDataUplinkRate;
                uint64 UtilizationReceive;
                uint64 UtilizationTransmit;
                uint32 EstMACDataRateDownlink;
                uint32 EstMACDataRateUplink;
                uint32 SignalStrength;
                uint32 LastConnectTime;
                uint32 Noise;
                uint32 OpClass;
                uint32 Channel;
            }
        }
    }
}
