%config {
    define-behavior = {
        existing-object = "update"
    };
}

%define {
    select @DATAELEMENTS_ROOT_DM@ {
        /**
        * This object contains the events generated when a STA associates to a BSS.
        * @version 2.19.1
        */
        object AssociationEvent {
            /**
            * The event is generated when an Associated Device (STA) associates to a BSS.
            */
            event 'Associated!' {
                string BSSID;
                string MACAddress;
                uint32 StatusCode;
                datetime TimeStamp;
                htable HTCapabilities;
                htable VHTCapabilities;
                string ClientCapabilities;
                uint32 OpClass;
                uint32 Channel;
                htable WiFi6Capabilities;
            }
        }
    }
}
