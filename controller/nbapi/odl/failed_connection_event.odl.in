%config {
    define-behavior = {
        existing-object = "update"
    };
}

%define {
    select @DATAELEMENTS_ROOT_DM@ {
        /**
        * This object contains the events generated when a Station (STA) fails to connect
        * to a Basic Service Set (BSS).
        * @version 2.19.1
        */
        object FailedConnectionEvent {
            /**
            * The event is generated when an Associated Device (STA) fails to connect to a BSS.
            */
            event 'FailedConnection!' {
                string BSSID;
                string MACAddress;
                uint32 StatusCode;
                uint32 ReasonCode;
                datetime TimeStamp;
            }
        }
    }
}
