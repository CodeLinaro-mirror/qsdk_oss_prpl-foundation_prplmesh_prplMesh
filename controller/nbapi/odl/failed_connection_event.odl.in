%config {
    define-behavior = {
        existing-object = "update"
    };
}

%define {
    select @DATAELEMENTS_ROOT_DM@ {
        /**
        * Container for the events generated when a Station (STA) fails to connect to a
        * Basic Service Set (BSS).
        *
        * TR-181 keeps this object as the mount point of the USP event
        * Device.WiFi.DataElements.FailedConnectionEvent.FailedConnection!. Only its
        * FailedConnectionEventData.{i}. table and FailedConnectionEventDataNumberOfEntries
        * were deprecated in 2.17 and deleted in 2.20, precisely because the USP event
        * replaces them, so the object itself must stay. It holds no data until the event
        * is implemented, which costs one amxd_object_t and nothing per station.
        * @version 2.15
        */
        object FailedConnectionEvent {
        }
    }
}
