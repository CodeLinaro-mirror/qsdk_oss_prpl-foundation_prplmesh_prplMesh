%populate {
	object '@TEMPLATES_ROOT_DM@' {
		object 'Network' {
			parameter 'Enable' = false;
			parameter 'TopologyFlag' = "Root,Repeater";
			parameter 'IEEE1905ALID' = "";
			parameter 'PrimarySSCTemplateReference' = "";
		}

		/* ---------------------- */
		/* Radios (2.4 / 5 / 6 GHz) */
		/* ---------------------- */
		object RadioTemplate {
			instance add ("cpe-RadioTemplate-1") {
				parameter 'RadioTemplateID' = "radio-template-1";
				parameter 'Enable' = true;
				parameter 'Priority' = 200;
				parameter 'BandFlag' = "2.4";
				parameter 'TransmitPowerLimit' = 20;
			}
			instance add ("cpe-RadioTemplate-2") {
				parameter 'RadioTemplateID' = "radio-template-2";
				parameter 'Enable' = true;
				parameter 'Priority' = 200;
				parameter 'BandFlag' = "5";
				parameter 'TransmitPowerLimit' = 20;
			}
			instance add ("cpe-RadioTemplate-3") {
				parameter 'RadioTemplateID' = "radio-template-3";
				parameter 'Enable' = true;
				parameter 'Priority' = 200;
				parameter 'BandFlag' = "6";
				parameter 'TransmitPowerLimit' = 23;
			}
		}

		/* ---------------------- */
		/* SSC (purpose collections) */
		/* .1 backhaul, .2 private, .3 guest */
		/* ---------------------- */
		object SSCTemplate {
			instance add ("cpe-SSCTemplate-backhaul") {
				parameter 'SSCTemplateID' = "ssc-backhaul";
				parameter 'SSCEnable' = true;
				parameter 'VID' = 0;
				parameter 'HaulType' = "Backhaul";
			}
			instance add ("cpe-SSCTemplate-private") {
				parameter 'SSCTemplateID' = "ssc-private";
				parameter 'SSCEnable' = true;
				parameter 'VID' = 0;
				parameter 'HaulType' = "Fronthaul";
			}
			instance add ("cpe-SSCTemplate-guest") {
				parameter 'SSCTemplateID' = "ssc-guest";
				parameter 'SSCEnable' = true;
				parameter 'VID' = 0;
				parameter 'HaulType' = "Fronthaul";
			}
		}

		/* ---------------------- */
		/* Security Templates     */
		/* ---------------------- */
		object SecurityTemplate {
			/* WPA3-Personal only (SAE) */
			instance add ("cpe-wpa3-personal") {
				parameter 'Alias' = "cpe-wpa3-personal";
				parameter 'SecurityTemplateID' = "sec-template-wpa3-personal";
				parameter 'Enable' = true;
				parameter 'Priority' = 220;
				parameter 'RSNOSupportFlag' = "null";
				object RSNE {
					parameter 'GroupDataCipherSuite' = "ccmp";
					parameter 'PairwiseCipherSuite' = "ccmp";
					parameter 'GroupManagementCipherSuite' = "";
					parameter 'AKMSuite' = "sae";
					parameter 'AKMSuiteSelector' = "";
					parameter 'MFP' = "Required";
				}
			}
			/* WPA3-Personal Transition (PSK+SAE in base RSNE) */
			instance add ("cpe-wpa3-personal-transition") {
				parameter 'Alias' = "cpe-wpa3-personal-transition";
				parameter 'SecurityTemplateID' = "sec-template-wpa3-personal-transition";
				parameter 'Enable' = true;
				parameter 'Priority' = 210;
				parameter 'RSNOSupportFlag' = "null";
				object RSNE {
					parameter 'GroupDataCipherSuite' = "ccmp";
					parameter 'PairwiseCipherSuite' = "ccmp";
					parameter 'GroupManagementCipherSuite' = "";
					parameter 'AKMSuite' = "psk,sae";
					parameter 'AKMSuiteSelector' = "";
					parameter 'MFP' = "Capable";
				}
			}
			/*
			 * WPA3-Personal Compatibility Mode (PCM / RSN Overriding).
			 * DM pattern: RSNOSupportFlag=true + RSNE.AKMSuite="psk,sae".
			 * Code then splits on-air IEs:
			 *   2.4/5 GHz: RSNE=PSK, RSNOE=SAE, RSNO2E=SAE-EXT-KEY
			 *   6 GHz:     RSNE=SAE,  no RSNOE,  RSNO2E=SAE-EXT-KEY
			 */
			instance add ("cpe-wpa3-personal-compatibility") {
				parameter 'Alias' = "cpe-wpa3-personal-compatibility";
				parameter 'SecurityTemplateID' = "sec-template-wpa3-personal-compatibility";
				parameter 'Enable' = true;
				parameter 'Priority' = 210;
				parameter 'RSNOSupportFlag' = "true";
				parameter 'SupportedAKMSuiteFlag' = "";
				parameter 'SupportedAKMSuiteSelectorFlag' = "";
				parameter 'OperatingGenerationFlag' = "";
				parameter 'SecurityIEs' = "";
				object RSNE {
					parameter 'GroupDataCipherSuite' = "ccmp";
					parameter 'PairwiseCipherSuite' = "ccmp";
					parameter 'GroupManagementCipherSuite' = "";
					parameter 'AKMSuite' = "psk,sae";
					parameter 'AKMSuiteSelector' = "";
					parameter 'MFP' = "Required";
				}
			}
			/* WPA2-Personal only (PSK) */
			instance add ("cpe-wpa2-personal") {
				parameter 'Alias' = "cpe-wpa2-personal";
				parameter 'SecurityTemplateID' = "sec-template-wpa2-personal";
				parameter 'Enable' = true;
				parameter 'Priority' = 200;
				parameter 'RSNOSupportFlag' = "null";
				object RSNE {
					parameter 'GroupDataCipherSuite' = "ccmp";
					parameter 'PairwiseCipherSuite' = "ccmp";
					parameter 'GroupManagementCipherSuite' = "";
					parameter 'AKMSuite' = "psk";
					parameter 'AKMSuiteSelector' = "";
					parameter 'MFP' = "Capable";
				}
			}
		}

		/* ---------------------- */
		/* Security Groups        */
		/* ---------------------- */
		object SecurityGroup {
			instance add ("cpe-sec-group-wpa3-personal") {
				parameter 'SecurityGroupID' = "sec-group-wpa3-personal";
				parameter 'SecurityTemplateReferences' = "@TEMPLATES_ROOT_DM@.SecurityTemplate.1";
			}
			instance add ("cpe-sec-group-wpa3-personal-transition") {
				parameter 'SecurityGroupID' = "sec-group-wpa3-personal-transition";
				parameter 'SecurityTemplateReferences' = "@TEMPLATES_ROOT_DM@.SecurityTemplate.2";
			}
			instance add ("cpe-sec-group-wpa3-personal-compatibility") {
				parameter 'SecurityGroupID' = "sec-group-wpa3-personal-compatibility";
				parameter 'SecurityTemplateReferences' = "@TEMPLATES_ROOT_DM@.SecurityTemplate.3";
			}
			instance add ("cpe-sec-group-wpa2-personal") {
				parameter 'SecurityGroupID' = "sec-group-wpa2-personal";
				parameter 'SecurityTemplateReferences' = "@TEMPLATES_ROOT_DM@.SecurityTemplate.4";
			}
		}

		/* ---------------------- */
		/* APMLD (MLO disabled)   */
		/* ---------------------- */
		object APMLDTemplate {
			instance add ("cpe-APMLDTemplate-1") {
				parameter 'Alias' = "apmld-default-mlo";
				parameter 'APMLDTemplateID' = "apmld-template-001";
				parameter 'MLOEnable' = false;
				parameter 'STREnable' = true;
				parameter 'NSTREnable' = false;
				parameter 'EMLSREnable' = false;
				parameter 'EMLMREnable' = false;
				parameter 'TIDToLinkMapNegotiation' = false;
			}
		}

		/* ---------------------- */
		/* BSS Templates          */
		/* bSTA-MLD: add affiliates separately */
		/* ---------------------- */
		object BSSTemplate {
			instance add ("cpe-BSSTemplate-priv-5") {
				parameter 'BSSTemplateID' = "PRPL-PRIVATE-5G";
				parameter 'Enable' = false;
				parameter 'Priority' = 230;
				parameter 'SSID' = "PRPL-PRIVATE-5G";
				parameter 'KeyPassphrase' = "password";
				parameter 'AdvertisementEnable' = true;
				parameter 'TopologyFlag' = "Root,Repeater";
				parameter 'X_PRPLWARE-COM_VapType' = "home";
				parameter 'RadioTemplateReference' = "@TEMPLATES_ROOT_DM@.RadioTemplate.2";
				parameter 'SSCTemplateReference' = "@TEMPLATES_ROOT_DM@.SSCTemplate.2";
				parameter 'SecurityGroupReference' = "@TEMPLATES_ROOT_DM@.SecurityGroup.1";
			}
			instance add ("cpe-BSSTemplate-guest-5") {
				parameter 'BSSTemplateID' = "PRPL-GUEST-5G";
				parameter 'Enable' = false;
				parameter 'Priority' = 220;
				parameter 'SSID' = "PRPL-GUEST-5G";
				parameter 'KeyPassphrase' = "password";
				parameter 'AdvertisementEnable' = true;
				parameter 'TopologyFlag' = "Root,Repeater";
				parameter 'X_PRPLWARE-COM_VapType' = "guest";
				parameter 'RadioTemplateReference' = "@TEMPLATES_ROOT_DM@.RadioTemplate.2";
				parameter 'SSCTemplateReference' = "@TEMPLATES_ROOT_DM@.SSCTemplate.3";
				parameter 'SecurityGroupReference' = "@TEMPLATES_ROOT_DM@.SecurityGroup.3";
			}
			instance add ("cpe-BSSTemplate-bh-2.4") {
				parameter 'BSSTemplateID' = "PRPL-BH-2G";
				parameter 'Enable' = false;
				parameter 'Priority' = 240;
				parameter 'SSID' = "PRPL-BH-2G";
				parameter 'KeyPassphrase' = "password";
				parameter 'AdvertisementEnable' = false;
				parameter 'TopologyFlag' = "Root,Repeater";
				parameter 'X_PRPLWARE-COM_VapType' = "backhaul";
				parameter 'RadioTemplateReference' = "@TEMPLATES_ROOT_DM@.RadioTemplate.1";
				parameter 'SSCTemplateReference' = "@TEMPLATES_ROOT_DM@.SSCTemplate.1";
				parameter 'SecurityGroupReference' = "@TEMPLATES_ROOT_DM@.SecurityGroup.2";
			}
		}
	}
}
