%config {
    define-behavior = {
        existing-object = "update"
    };
}

%define {
    select @DATAELEMENTS_ROOT_DM@.Network.Device.Radio.BSS {

        /**
        * [MACAddress] The MAC Address of the logical BSS (BSSID).
        * If the instance of this BSS is the same as Device.WiFi.SSID.{i}., then this parameter is the same as Device.WiFi.SSID.{i}.BSSID.
        * @version 2.19.1
        */
        %read-only %unique string BSSID = "0";

        %read-only string SSID = "0";

        /**
        * Whether the BSSID is currently enabled (beaconing frames are being sent) or disabled.
        * If the instance of this BSS is the same as Device.WiFi.SSID.{i}., then this parameter is the same as Device.WiFi.SSID.{i}.Enable.
        * @version 2.19.1
        */
        %read-only bool Enabled = false;

        %read-only bool IsVBSS = false;
        %read-only uint32 LastChange = 0 {
            on action read call action_read_last_change;
        }

        %read-only string TimeStamp = "2020-08-31T11:22:39Z";
        %read-only uint64 UnicastBytesSent = 0;
        %read-only uint64 UnicastBytesReceived = 0;
        %read-only uint64 MulticastBytesSent = 0;
        %read-only uint64 MulticastBytesReceived = 0;
        %read-only uint64 BroadcastBytesSent = 0;
        %read-only uint64 BroadcastBytesReceived = 0;

        %read-only uint32 EstServiceParametersBE = 0 {
            on action validate call check_range [0, 16777215];
        }

        %read-only uint32 EstServiceParametersBK = 0 {
            on action validate call check_range [0, 16777215];
        }

        %read-only uint32 EstServiceParametersVI = 0 {
            on action validate call check_range [0, 16777215];
        }

        %read-only uint32 EstServiceParametersVO = 0 {
            on action validate call check_range [0, 16777215];
        }

        %read-only uint32 ByteCounterUnits = 0x0;

        /**
        * Indicates that this BSS is in use as a fronthaul BSS;
        * true: fronthaul BSS in use,
        * false: fronthaul BSS not in use.
        * In [EasyMesh] 0 is in use and 1 is not in use.
        * @version 2.19.1
        */
        %read-only bool FronthaulUse = false;

        /**
        * Indicates that this BSS is in use as a backhaul BSS;
        * true: backhaul BSS in use,
        * false: backhaul BSS not in use.
        * In [EasyMesh] 0 is in use and 1 is not in use.
        * @version 2.19.1
        */
        %read-only bool BackhaulUse = false;

        %instance bool TriggerVBSSDestruction(
            %in %mandatory string client_mac,
            %in bool should_disassociate = true
        );

        %instance bool TriggerVBSSMove(
            %in %mandatory string client_mac,
            %in %mandatory string dest_ruid,
            %in %mandatory string ssid,
            %in %mandatory string pass
        );

        %instance bool SetEHTOperations(
            %in %mandatory uint16 DisabledSubchannelBitmap
        );

        /**
        * Object describing a single Associated Device (STA).
        * At most one entry in this table can exist with a given value for MACAddress.
        * @version 2.19.1
        */
        %read-only object STA [] {
            counted with STANumberOfEntries;
        }

        %read-only object MultiAPSteering {
           %read-only uint64 BlacklistAttempts = 0;
           %read-only uint64 BTMAttempts = 0;
           %read-only uint64 BTMQueryResponses = 0;
        }
    }
}
