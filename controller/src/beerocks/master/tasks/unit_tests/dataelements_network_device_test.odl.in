%define {
    @DATAELEMENTS_ROOT_DM_Header@
        %read-only object Network {
            %read-only object Device [] {
                counted with DeviceNumberOfEntries;
                %read-only %unique string ID;
            }
        }
    @DATAELEMENTS_ROOT_DM_Footer@
}
