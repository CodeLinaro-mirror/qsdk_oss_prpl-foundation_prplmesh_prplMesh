#!/bin/sh
###############################################################
# SPDX-License-Identifier: BSD-2-Clause-Patent
# SPDX-FileCopyrightText: 2019-2026 the prplMesh contributors (see AUTHORS.md)
# This code is subject to the terms of the BSD+Patent license.
# See LICENSE file for more details.
###############################################################

SCRIPTDIR="$(dirname "$(readlink -f "${0}")")"
PRPLMESH_DIR="$(cd "${SCRIPTDIR}/.." && pwd)"
PROCESS_MANAGER_DM_PATH="X_PRPLWARE-COM_ProcessManager"

send_signal_to_prplmesh_process() {
    PROGRAM_NAME=$1
    SIG=${2:-TERM}

    echo "sending signal to ${PROGRAM_NAME} (${SIG})"
    start-stop-daemon -K -s "${SIG}" -x "${PRPLMESH_DIR}/bin/${PROGRAM_NAME}" > /dev/null 2>&1
}

start_prplmesh_process() {
    PROGRAM_NAME=$1

    echo "starting ${PROGRAM_NAME}"
    if [ "$PRPLMESH_FOREGROUND" -eq 1 ]; then
        "${PRPLMESH_DIR}/bin/${PROGRAM_NAME}" &
        PRPLMESH_PIDS="${PRPLMESH_PIDS} $!"
    else
        start-stop-daemon -S -b -x "${PRPLMESH_DIR}/bin/${PROGRAM_NAME}" > /dev/null 2>&1
    fi
}

stop_prplmesh_processes() {
    TIMEOUT=10

    for name in "$@"; do
        echo "stop ${name} via signals"
        send_signal_to_prplmesh_process "${name}"
    done

    for _ in $(seq 1 "${TIMEOUT}"); do
        running=""
        for name in "$@"; do
            if start-stop-daemon -K -t -q -x "${PRPLMESH_DIR}/bin/${name}"; then
                running="${running} ${name}"
            fi
        done
        [ -z "${running}" ] && return 0
        sleep 1
    done

    for name in ${running}; do
        send_signal_to_prplmesh_process "${name}" "KILL"
    done
}

roll_logs_function() {
    ROLL_PROGRESS_DIR="roll_in_progress.lock"

    # Switch into the beerocks logs folder
    cd @BEEROCKS_LOG_FILES_PATH@ || exit

    # Check if log roll already in progress
    if ! mkdir "$ROLL_PROGRESS_DIR"
    then
        echo "Roll already in progress... Exiting..."
        exit 0
    fi

    # Symlinks point to all log files that can be rotated
    links=$(for file in *; do readlink "$file" > /dev/null && echo "$file"; done)

    for link in $links; do
        # Keep the last 3 versions of the log file
        echo "$link" | sed -e 's/log$/*/' | xargs find . -name | sort -r | awk 'NR>3' | xargs rm -f
    done

    # Send USR1 signals to the beerocks processes to trigger log rolling
    send_signal_to_prplmesh_process beerocks_controller USR1
    send_signal_to_prplmesh_process beerocks_agent USR1
    send_signal_to_prplmesh_process beerocks_fronthaul USR1
    send_signal_to_prplmesh_process beerocks_vendor_message USR1

    # Cleanup
    rm -r "$ROLL_PROGRESS_DIR"
}

usage() {
    echo "usage: $(basename "$0") {start|stop|restart|status|roll_logs} [-h] [-f|--foreground] [-m MODE] [-c CERT_MODE]"
}

ensure_platform_db() {
    mkdir -p "@TMP_PATH@"
    if [ ! -e "@TMP_PATH@/prplmesh_platform_db" ]; then
        cp "${PRPLMESH_DIR}/share/prplmesh_platform_db" "@TMP_PATH@/prplmesh_platform_db"
    fi
}

certification_mode_to_num() {
    case "$1" in
        1|true|TRUE|yes|on)  echo 1 ;;
        0|false|FALSE|no|off) echo 0 ;;
        *)
            echo "Unsupported certification_mode: \"$1\" (use 0/1/true/false)" >&2
            return 1
            ;;
    esac
}

validate_modes() {
    if [ -n "${PRPLMESH_MODE}" ]; then
        case "${PRPLMESH_MODE}" in
            Not-Multi-AP|Multi-AP-Agent|Multi-AP-Controller|Multi-AP-Controller-and-Agent|Non-Prpl-Controller-and-Agent)
                ;;
            *)
                echo "unsupported mode: \"${PRPLMESH_MODE}\"" >&2
                return 1
                ;;
        esac
    fi

    if [ -n "${CERTIFICATION_MODE}" ]; then
        CERTIFICATION_MODE=$(certification_mode_to_num "${CERTIFICATION_MODE}") || return 1
    fi

    return 0
}

pm_set() {
    if ! pm_reply=$(ba-cli "${PROCESS_MANAGER_DM_PATH}.PrplMesh.$1" 2>&1) ||
    printf '%s\n' "$pm_reply" | grep -q '^ERROR:'; then
        echo "Failed to set ${PROCESS_MANAGER_DM_PATH}.PrplMesh.$1: ${pm_reply}" >&2
        return 1
    fi
}

platform_db_key() {
    case "$1" in
        ManagementMode)    echo management_mode ;;
        CertificationMode) echo certification_mode ;;
    esac
}

# The modes are stored in the Process Manager data model when it is
# present, and in the platform db otherwise.
mode_get() {
    if [ "$PROCESS_MANAGER_DETECTED" -eq 1 ]; then
        ba-cli -l "${PROCESS_MANAGER_DM_PATH}.PrplMesh.$1?" 2>/dev/null | grep -v '^ERROR:' | tr -d '\n'
    else
        sed -n "s/^$(platform_db_key "$1")=//p" "@TMP_PATH@/prplmesh_platform_db" 2>/dev/null
    fi
}

mode_set() {
    echo "Set prplMesh $1 to $2"

    if [ "$PROCESS_MANAGER_DETECTED" -eq 1 ]; then
        case "$1" in
            ManagementMode) pm_set "$1=\"$2\"" ;;
            *)              pm_set "$1=$2" ;;
        esac
    else
        key=$(platform_db_key "$1")
        sed -i "s/^${key}=.*/${key}=$2/" "@TMP_PATH@/prplmesh_platform_db"
    fi
}

apply_modes() {
    if [ -n "${PRPLMESH_MODE}" ]; then
        mode_set ManagementMode "${PRPLMESH_MODE}" || return 1
    fi
    if [ -n "${CERTIFICATION_MODE}" ]; then
        mode_set CertificationMode "${CERTIFICATION_MODE}" || return 1
    fi
    return 0
}

# BusyBox ash "wait -n" keeps waiting when a job exits with a non-zero status
# and then returns the status of a later job, so poll the children instead.
wait_first_child() {
    while :; do
        for pid in $PRPLMESH_PIDS; do
            if ! kill -0 "$pid" 2>/dev/null; then
                wait "$pid"
                return
            fi
        done
        sleep 1
    done
}

start_func() {
    # This is required for solveing issue which causing meesges not geeting to their destination.
    # For more information see: https://github.com/prplfoundation/prplMesh/pull/1029#issuecomment-608353274
    ebtables -A FORWARD -d 01:80:c2:00:00:13 -j DROP

    if [ "$PRPLMESH_FOREGROUND" -eq 1 ]; then
        trap 'trap "" TERM INT HUP; stop_func' EXIT
        trap 'exit 0' TERM INT HUP
    fi

    mode=$(mode_get ManagementMode)
    [ -z "$mode" ] && mode="@BEEROCKS_MANAGEMENT_MODE@"

    echo "Starting prplMesh (mode=${mode})"

    start_prplmesh_process ieee1905_transport
    if [ "${mode}" != "Multi-AP-Agent" ] && [ "${mode}" != "Non-Prpl-Controller-and-Agent" ]; then
        start_prplmesh_process beerocks_controller
    fi
    start_prplmesh_process beerocks_agent
    start_prplmesh_process beerocks_vendor_message
    if [ "$PRPLMESH_FOREGROUND" -eq 1 ]; then
        wait_first_child
        exit $?
    fi
    return 0
}

stop_func() {
    echo "Stopping prplMesh"
    stop_prplmesh_processes beerocks_vendor_message beerocks_agent beerocks_fronthaul \
        beerocks_controller
    # The other daemons talk through the transport, stop it last.
    stop_prplmesh_processes ieee1905_transport
    wait

    ebtables -D FORWARD -d 01:80:c2:00:00:13 -j DROP
    return 0
}

# Process Manager owns the daemons, unless this is its procd supervisor.
prplmesh_stop() {
    if [ "$PM_LIFECYCLE" -eq 1 ]; then
        pm_set Enable=0
    else
        stop_func
    fi
}

prplmesh_start() {
    if [ "$PM_LIFECYCLE" -eq 1 ]; then
        pm_set Enable=1
    else
        start_func
    fi
}

main() {
    if ! OPTS=$(getopt -o 'hfm:c:' -l 'help,foreground,mode:,cert:' -n 'parse-options' -- "$@"); then
        echo "Failed parsing options." >&2
        usage
        exit 1
    fi

    eval set -- "$OPTS"
    echo "OPTS=${OPTS}"

    while true; do
        case "${1}" in
            -f | --foreground)   PRPLMESH_FOREGROUND=1; shift ;;
            -h | --help)          usage; exit 0 ;;
            -m | --mode)          PRPLMESH_MODE="${2}"; shift; shift ;;
            -c | --cert)          CERTIFICATION_MODE="${2}"; shift; shift ;;
            -- ) shift; break ;;
            * ) echo "unsupported argument ${1}"; usage; exit 1 ;;
        esac
    done

    validate_modes || exit 1

    if [ "$PRPLMESH_FOREGROUND" -eq 0 ]; then
        # Detached processes must survive a closed terminal or output pipe.
        trap '' HUP PIPE
    fi

    if pm_reply=$(ba-cli -l "${PROCESS_MANAGER_DM_PATH}.?0" 2>&1) &&
    ! printf '%s\n' "$pm_reply" | grep -q '^ERROR:'; then
        echo "Process Manager detected"
        PROCESS_MANAGER_DETECTED=1
    fi

    if [ "$PROCESS_MANAGER_DETECTED" -eq 0 ]; then
        ensure_platform_db
    elif [ "$PRPLMESH_FOREGROUND" -eq 0 ]; then
        PM_LIFECYCLE=1
    else
        # A second supervisor would start a second set of daemons.
        if [ "$(cat "/proc/${PPID}/comm" 2>/dev/null)" != "procd" ]; then
            echo "prplMesh is managed by Process Manager, -f is reserved for procd." >&2
            return 1
        fi
        # Changing a mode makes Process Manager restart this supervisor.
        if [ -n "${PRPLMESH_MODE}${CERTIFICATION_MODE}" ]; then
            echo "-m and -c are not supported with -f, set the modes in Process Manager." >&2
            return 1
        fi
    fi

    case "${1}" in
        "start" | "restart")
            prplmesh_stop || return 1 # Need to stop first for correctly apply modes
            apply_modes || echo "Warning: failed to set mode, starting with existing configuration"
            prplmesh_start || return 1
            ;;
        "stop")
            prplmesh_stop || return 1
            ;;
        "status")
            "${PRPLMESH_DIR}/bin/prplmesh_cli" -c status -o pretty
            ;;
        "roll_logs")
            roll_logs_function
            return $?
            ;;
        *)
            echo "unsupported argument \"${1}\""; usage; exit 1 ;;
    esac

    # Give write permissions (linux only)
    # shellcheck disable=SC2050
    chmod -R +o+w "/tmp/beerocks" || true

    return 0
}

PRPLMESH_FOREGROUND=0
PRPLMESH_PIDS=""
PROCESS_MANAGER_DETECTED=0
PM_LIFECYCLE=0
PRPLMESH_MODE=""
CERTIFICATION_MODE=""

main "$@"
